# Copy this file to .env, then replace placeholders with the receiver's own values.
# Never send a populated .env to another person.
VIDU_API_KEY=replace_with_your_key
VIDU_API_BASE=https://api.vidu.cn
INTERACTIVE_FILM_PORT=5100
FFMPEG_PATH=ffmpeg

# Required only when Vidu S1 should call this machine's memory/knowledge API.
# PUBLIC_BASE_URL must be a public HTTPS tunnel URL, not localhost.
PUBLIC_BASE_URL=
MEMORY_TOKEN=replace_with_a_random_callback_token
STORY_MEMORY_ENABLED=false
STORY_KNOWLEDGE_ENABLED=false
RETRIEVAL_TIMEOUT_MS=3000

# PolarDB Mem0 upstream. The receiver must use their own endpoint and token.
POLARDB_MEM0_BASE_URL=
POLARDB_MEM0_USER_ID=
POLARDB_MEM0_AUTHORIZATION=
MEM0_TIMEOUT=60

# Optional knowledge upstream.
KNOWLEDGE_UPSTREAM_URL=
KNOWLEDGE_UPSTREAM_AUTHORIZATION=
KNOWLEDGE_UPSTREAM_TIMEOUT_MS=3000

# Optional protection when exposing the UI publicly.
CONSOLE_AUTH_USER=
CONSOLE_AUTH_PASS=
